# Documentación de las variables de la plataforma.
#
# Los valores por modo viven en envs/<modo>.env (versionados, sin secretos).
# Los secretos los genera `make setup` en secrets/compose.env, que está ignorado
# por Git. Este archivo solo documenta qué espera docker-compose.yml.

# Secretos generados por `make setup` (no poner valores reales aquí):
#   POSTGRES_SUPERUSER_PASSWORD
#   DB_IDENTITY_PASSWORD
#   DB_INVENTORY_PASSWORD
#   DB_STORE_PASSWORD
#   DB_REPORTS_PASSWORD
#   DB_TICKETS_PASSWORD
#   RABBITMQ_PASSWORD
#   JWT_KID

# Variables no secretas, definidas en envs/<modo>.env:
#   POSTGRES_PORT
#   RABBITMQ_MANAGEMENT_PORT
#   SESSION_MODE        separate | shared
#   INTEGRATION_MODE    standalone | integrated
#   SEED_DEMO_DATA      true | false
#   DEMO_PASSWORD       contraseña pública de la demo
#   INITIAL_ADMIN_EMAIL email de la primera cuenta admin
